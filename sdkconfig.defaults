# Enable Bluetooth and NimBLE for week 4 BLE phone capture
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_PINNED_TO_CORE=1
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_HOST_TASK_PRIORITY=5
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=12

# PSRAM（ESP32-S3-WROOM-1 N8R8，8MB Octal @80MHz）——相机帧缓冲必须落在 PSRAM 上，
# 且 esp_psram 组件的 esp_psram.c 只有 CONFIG_SPIRAM=y 时才参与编译
# （否则会出现 undefined reference to `esp_psram_is_initialized` 链接错误）。
# 放在 defaults 里，保证 sdkconfig 被重新生成/换工程路径后配置不会丢失。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# 分区表：kernel 1.17MB 的固件放不进默认 1MB factory，必须用 singleapp_large(1.5MB)
# 不加这两行，会报 “app partition is too small for binary imu_web_demo.bin size 0x12a230”
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"

# 相机：ESP32-S3 允许从 PSRAM 直接 DMA（组件默认 n，本工程需要 y）
CONFIG_CAMERA_PSRAM_DMA=y